[Unit]
Description=Refresh simulation experiment and rollout artifact indexes

[Service]
Type=oneshot
WorkingDirectory=%h/bimanual-vla
ExecStart=%h/miniconda3/envs/openpi/bin/python -m server_4090.artifact_index_repair --config %h/bimanual-vla/server_4090/config.simulation.json --request --remote
Nice=10
KillMode=process
TimeoutStartSec=20min
UMask=0077

[Install]
WantedBy=default.target
