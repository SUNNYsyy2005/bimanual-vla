[Unit]
Description=Bimanual VLA Dashboard
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=%h/bimanual-vla
ExecStart=%h/bimanual-vla/server_4090/run_server_foreground.sh %h/bimanual-vla/server_4090/config.json
ExecStopPost=/usr/bin/rm -f %h/.local/share/bimanual-vla-server/dashboard.pid
Restart=always
RestartSec=5
TimeoutStopSec=20

# Dashboard-managed training and Policy processes must survive a Dashboard
# restart. They are reattached from the persisted task registry after startup.
KillMode=process

Environment=PYTHONUNBUFFERED=1
LimitNOFILE=65536
UMask=0077

[Install]
WantedBy=default.target
